---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

const d = post.data.date;
const meta =
  `${d.getUTCFullYear()} · ${String(d.getUTCMonth() + 1).padStart(2, "0")} · ${String(d.getUTCDate()).padStart(2, "0")}` +
  (post.data.readingTime ? ` · ${post.data.readingTime}` : "") +
  ` · ${post.data.tag}`;
---

<Base title={`${post.data.title} — Ambient Blog`} description={post.data.description} active="blog">
  <div class="wrap">
    <article class="article prose">
      <div style="padding-top:56px">
        <a class="back-link" href={`${base}blog/`}>‹ All posts</a>
        <div class="meta">{meta}</div>
        <h1 style="font-size:clamp(2.2rem,5vw,3.2rem);margin-bottom:8px">{post.data.title}</h1>
      </div>
      <Content />
    </article>
  </div>
</Base>
