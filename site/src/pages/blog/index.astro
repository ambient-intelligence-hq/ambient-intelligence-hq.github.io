---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function fmt(d: Date) {
  const y = d.getUTCFullYear();
  const m = String(d.getUTCMonth() + 1).padStart(2, "0");
  const day = String(d.getUTCDate()).padStart(2, "0");
  return `${y} · ${m} · ${day}`;
}
---

<Base
  title="Ambient Blog"
  description="Notes from the team building Ambient — the video-understanding agent engine."
  active="blog"
>
  <section class="page-head dotgrid hair-bottom">
    <div class="wrap">
      <span class="eyebrow mono">Blog</span>
      <h1>Notes from the engine room</h1>
      <p>How we build a system that watches video like an agent — architecture, latency, and the road from prototype to production.</p>
    </div>
  </section>

  <div class="wrap">
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-card reveal" href={`${base}blog/${post.id}/`}>
          <div class="meta">{fmt(post.data.date)}{post.data.readingTime ? <><br />{post.data.readingTime}</> : null}</div>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="tag">{post.data.tag}</span>
          </div>
        </a>
      ))}

      {posts.length === 0 && (
        <p style="color:var(--text-muted)">No posts yet. Add a Markdown file under <code>src/content/blog/</code>.</p>
      )}
    </div>
  </div>
</Base>
