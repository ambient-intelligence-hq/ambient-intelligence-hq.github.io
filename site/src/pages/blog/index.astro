---
import Base from "../../layouts/Base.astro";
import { getPosts, readingTime, formatDate } from "../../lib/blog";

const base = import.meta.env.BASE_URL;

const posts = await Promise.all(
  (await getPosts()).map(async (post) => ({ post, minutes: await readingTime(post) })),
);
---

<Base
  title="Ambient Blog"
  description="Notes from the team building Ambient, the open-source video engine for AI agents."
  active="blog"
>
  <section class="page-head dotgrid hair-bottom">
    <div class="wrap">
      <span class="eyebrow mono">Blog</span>
      <h1>Notes from the engine room</h1>
      <p>How we build a system that watches video like an agent — architecture, latency, and the road from prototype to production.</p>
    </div>
  </section>

  <div class="wrap">
    <div class="post-list">
      {posts.map(({ post, minutes }) => (
        <a class="post-card reveal" href={`${base}blog/${post.id}/`}>
          <div class="meta">{formatDate(post.data.date)}{minutes ? <><br />{minutes}</> : null}</div>
          <div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="tag">{post.data.tag}</span>
          </div>
        </a>
      ))}

      {posts.length === 0 && (
        <p style="color:var(--text-muted)">No posts yet. Add a Markdown or MDX file under <code>src/content/blog/</code>.</p>
      )}
    </div>
  </div>
</Base>
