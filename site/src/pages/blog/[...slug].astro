---
import Base from "../../layouts/Base.astro";
import { Image, getImage } from "astro:assets";
import { render } from "astro:content";
import { getPosts, readingTime, formatDate, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;

const minutes = await readingTime(post);
const meta = [formatDate(post.data.date), minutes, post.data.tag].filter(Boolean).join(" · ");

// Social preview: a 1200px JPEG of the cover, as an absolute URL.
const ogImage = post.data.cover
  ? new URL((await getImage({ src: post.data.cover, width: 1200, format: "jpg" })).src, Astro.site).href
  : undefined;
---

<Base title={`${post.data.title} — Ambient Blog`} description={post.data.description} active="blog" image={ogImage}>
  <div class="wrap">
    <article class="article prose">
      <div style="padding-top:56px">
        <a class="back-link" href={`${base}blog/`}>‹ All posts</a>
        <div class="meta">{meta}</div>
        <h1 style="font-size:clamp(2.2rem,5vw,3.2rem);margin-bottom:8px">{post.data.title}</h1>
      </div>
      {post.data.cover && (
        <Image
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          widths={[720, 1080, 1440]}
          sizes="(max-width: 760px) 100vw, 720px"
          loading="eager"
          style="width:100%;height:auto;border-radius:var(--radius);margin:24px 0 8px"
        />
      )}
      <Content />
    </article>
  </div>
</Base>
