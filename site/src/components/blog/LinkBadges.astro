---
/**
 * A row of resource links shown at the top of a post (code, models, papers),
 * each with the source's logo.
 */
interface Link {
  kind: "github" | "huggingface" | "arxiv";
  label: string;
  href: string;
}
interface Props {
  links: Link[];
}
const { links } = Astro.props as Props;
const source = { github: "GitHub", huggingface: "Hugging Face", arxiv: "arXiv" } as const;
---

<ul class="lb" role="list">
  {
    links.map((l) => (
      <li>
        <a class="lb-link" href={l.href} target="_blank" rel="noopener">
          {l.kind === "github" && (
            <svg class="lb-icon" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
          )}
          {l.kind === "huggingface" && <span class="lb-emoji" aria-hidden="true">🤗</span>}
          {l.kind === "arxiv" && <span class="lb-arxiv">arXiv</span>}
          {l.kind !== "arxiv" && <span class="lb-source">{source[l.kind]}:</span>}
          <span class="lb-label">{l.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .lb {
    list-style: none;
    display: flex !important;
    flex-wrap: wrap;
    gap: 8px !important;
    padding: 0 !important;
    margin: 20px 0 8px;
  }
  .lb-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border: 1px solid var(--hairline) !important;
    border-radius: 999px;
    background: var(--panel);
    color: var(--text) !important;
    font-size: 0.84rem;
    line-height: 1.3;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .lb-link:hover {
    border-color: var(--accent) !important;
    background: var(--panel-2);
  }
  .lb-icon {
    width: 15px;
    height: 15px;
    fill: var(--text);
    flex: none;
  }
  .lb-emoji {
    font-size: 0.95rem;
    line-height: 1;
  }
  .lb-arxiv {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: #fff;
    background: #b31b1b;
    border-radius: 4px;
    padding: 1px 5px;
  }
  .lb-source {
    font-weight: 600;
  }
  .lb-label {
    color: var(--accent);
  }
</style>
