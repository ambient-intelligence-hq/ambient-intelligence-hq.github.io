---
export interface Props {
  title: string;
  description?: string;
  active?: "home" | "docs" | "blog" | null;
  extraCss?: string[];
  /** Absolute URL of a social preview image (og:image). */
  image?: string;
}
const {
  title,
  description = "Ambient is the open-source video engine for AI agents. Any video in, any outcome out: agents watch footage of any length, gather evidence over time, and turn it into clips, structured data, reports, and actions.",
  active = null,
  extraCss = [],
  image,
} = Astro.props;

// BASE_URL always ends with "/" — prefix asset + internal links so the site
// works from a project subpath (/ambient/), a user page, or a custom domain.
const base = import.meta.env.BASE_URL;
const github = "https://github.com/ambient-intelligence-hq/ambient";
const brandMark = `${base}assets/img/ambient-mark.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="theme-color" content="#fdf6f1" />
    <link rel="icon" href={brandMark} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Ambient Blog" href={`${base}rss.xml`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,600;0,700;0,800;1,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}assets/css/styles.css`} />
    {extraCss.map((href) => <link rel="stylesheet" href={`${base}${href}`} />)}
  </head>
  <body>
    <!-- ============================ NAV ============================ -->
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={base} aria-label="Ambient home">
          <img class="logo" src={brandMark} alt="" />
          Ambient
        </a>
        <nav class="nav-links">
          <a href={base} class={active === "home" ? "active" : undefined}>Overview</a>
          <a href={`${base}#use-cases`}>Use cases</a>
          <a href={`${base}replay/`}>Demos</a>
          <a href={`${base}docs/`} class={active === "docs" ? "active" : undefined}>Docs</a>
          {/* Hidden until the Blog content is cleaned up — re-enable then.
          <a href={`${base}blog/`} class={active === "blog" ? "active" : undefined}>Blog</a>
          */}
          <a class="nav-gh" href={github} target="_blank" rel="noopener" title="GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
            <span class="nav-gh-label">GitHub</span>
          </a>
        </nav>
        <button class="nav-toggle" id="navToggle" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><path d="M3 6h18M3 12h18M3 18h18"></path></svg
          >
        </button>
      </div>
    </header>

    <slot />

    <!-- ============================ FOOTER ============================ -->
    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href={base}>
              <img class="logo" src={brandMark} alt="" />
              Ambient
            </a>
            <p style="max-width:24rem;font-size:0.95rem">
              The open-source video engine for AI agents. Any video in, any outcome out — self-hostable,
              SDK-native, model-agnostic.
            </p>
          </div>
          <div>
            <h4>Product</h4>
            <ul>
              <li><a href={`${base}#how`}>How it works</a></li>
              <li><a href={`${base}#use-cases`}>Use cases</a></li>
              <li><a href={`${base}#out`}>Action out</a></li>
              <li><a href={`${base}#scale`}>Self-hosting</a></li>
            </ul>
          </div>
          <div>
            <h4>Developers</h4>
            <ul>
              <li><a href={`${base}docs/`}>Documentation</a></li>
              <li><a href={`${base}docs/quickstart/`}>Quickstart</a></li>
              <li><a href={`${base}docs/studio/walkthrough/`}>Studio walkthrough</a></li>
              <li><a href={`${base}docs/sdk/quickstart/`}>SDK quickstart</a></li>
            </ul>
          </div>
          <div>
            <h4>More</h4>
            <ul>
              <li><a href={`${base}blog/`}>Blog</a></li>
              <li><a href={`${base}rss.xml`}>RSS</a></li>
              <li><a href={github} target="_blank" rel="noopener">GitHub</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© 2026 Ambient</span>
          <span>video in → understanding → action out</span>
        </div>
      </div>
    </footer>

    <script is:inline src={`${base}assets/js/main.js`}></script>
    <slot name="scripts" />
  </body>
</html>
