---
/**
 * Horizontal bars for one value across a set of rows (providers of a model,
 * leaderboard entries, ablation steps). One hue (magnitude); rows without a
 * number (rejected, ignored, timed out) draw no bar and state the outcome in
 * muted text instead. When some rows set `highlight`, the others are drawn in
 * a neutral tone so the highlighted ones stand out.
 */
interface Row {
  label: string;
  /** Second line under the label, e.g. "direct" or "via OpenRouter". */
  route?: string;
  /** Number to draw. Leave out for outcomes that have no number. */
  value?: number;
  /** Text shown at the end of the bar (defaults to the formatted value). */
  display?: string;
  /** Hover / focus detail. */
  detail?: string;
  /** Draw this row in the accent colour and the rest in neutral. */
  highlight?: boolean;
}
interface Props {
  title: string;
  unit: string;
  rows: Row[];
  caption?: string;
  source?: string;
  /** Value of a full-width bar (e.g. 1 for a score). Defaults to the largest value. */
  max?: number;
}
const { title, unit, rows, caption, source, max: scale } = Astro.props as Props;
const max = scale ?? Math.max(...rows.map((r) => r.value ?? 0));
const anyHighlight = rows.some((r) => r.highlight);
const fmt = (n: number) => n.toLocaleString("en-US");
---

<figure class="pb">
  <figcaption class="pb-title">
    {title}
    <span class="pb-unit">{unit}</span>
  </figcaption>
  <ul class="pb-rows" role="list">
    {
      rows.map((r) => {
        const has = typeof r.value === "number" && r.value > 0;
        const pct = has ? Math.max(0.6, (r.value! / max) * 100) : 0;
        const text = r.display ?? (has ? fmt(r.value!) : "");
        return (
          <li class="pb-row" tabindex={r.detail ? 0 : undefined} data-detail={r.detail}>
            <span class={r.highlight ? "pb-label pb-hl" : "pb-label"}>
              {r.label}
              {r.route && <span class="pb-route">{r.route}</span>}
            </span>
            <span class="pb-track">
              {has && (
                <span
                  class={anyHighlight && !r.highlight ? "pb-bar pb-muted" : "pb-bar"}
                  style={`width:calc((100% - 64px) * ${(Math.min(pct, 100) / 100).toFixed(4)})`}
                />
              )}
              <span class={has ? "pb-val" : "pb-val pb-none"}>{text}</span>
            </span>
            {r.detail && <span class="pb-tip" role="tooltip">{r.detail}</span>}
          </li>
        );
      })
    }
  </ul>
  {(caption || source) && (
    <p class="pb-foot">
      {caption}
      {source && (
        <>
          {" "}
          <a href={source}>Data</a>
        </>
      )}
    </p>
  )}
</figure>

<style>
  .pb {
    margin: 2em 0;
    padding: 20px 22px 16px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .pb-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--text);
    margin-bottom: 14px;
  }
  .pb-unit {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.82rem;
    color: var(--text-muted);
  }
  .pb-rows {
    list-style: none;
    padding: 0 !important;
    margin: 0;
    display: grid !important;
    gap: 2px !important;
  }
  .pb-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(120px, 30%) 1fr;
    align-items: center;
    gap: 12px;
    padding: 5px 0;
    border-radius: 6px;
    outline: none;
  }
  .pb-row[data-detail] { cursor: default; }
  .pb-row[data-detail]:hover,
  .pb-row[data-detail]:focus-visible { background: var(--panel-2); }
  .pb-label {
    font-size: 0.86rem;
    line-height: 1.25;
    color: var(--text);
  }
  .pb-hl { font-weight: 600; }
  .pb-hl .pb-route { font-weight: 400; }
  .pb-bar.pb-muted { background: var(--text-faint); }
  .pb-route {
    display: block;
    font-size: 0.74rem;
    color: var(--text-faint);
  }
  .pb-track {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .pb-bar {
    height: 14px;
    background: var(--accent);
    border-radius: 0 4px 4px 0;
    flex: none;
  }
  .pb-val {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text);
    white-space: nowrap;
  }
  .pb-none {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: normal;
  }
  .pb-tip {
    position: absolute;
    left: 30%;
    bottom: calc(100% + 4px);
    z-index: 5;
    max-width: 420px;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--ink-panel);
    color: var(--on-ink);
    font-size: 0.78rem;
    line-height: 1.45;
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.12s;
  }
  .pb-row:hover .pb-tip,
  .pb-row:focus-visible .pb-tip { opacity: 1; }
  .pb-foot {
    margin: 12px 0 0;
    font-size: 0.78rem !important;
    line-height: 1.5;
    color: var(--text-muted) !important;
  }
  @media (max-width: 560px) {
    .pb-row { grid-template-columns: 1fr; gap: 4px; }
    .pb-tip { left: 0; }
  }
</style>
