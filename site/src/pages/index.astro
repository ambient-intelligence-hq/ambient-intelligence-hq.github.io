---
import Base from "../layouts/Base.astro";
import AgentSetupModal from "../components/AgentSetupModal.astro";
import { AGENT_SETUP_PROMPT, AGENT_SETUP_BUTTON } from "../data/agent-setup";
const base = import.meta.env.BASE_URL;
// Hero demo video is swappable for review (HERO_VIDEO = filename in assets/video).
const heroVideo = process.env.HERO_VIDEO || "montage-demo.mp4";
const heroPoster = heroVideo.replace(/\.mp4$/, ".jpg");
const heroLabel = process.env.HERO_LABEL || "studio.ambient — Any video, Any outcome";
const github = "https://github.com/ambient-intelligence-hq/ambient";
const installUrl = "https://ambient-intelligence-hq.github.io/install.sh";
---

<Base
  title="Ambient — turn video into understanding + action"
  description="Ambient is an open-source video-to-action agent. It watches videos, gathers evidence over time, answers questions with citations, and invokes tools to take action."
  active="home"
  extraCss={["assets/css/home.css?v=5", "assets/css/showcase.css"]}
>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div>
          <span class="eyebrow">Video to action agent</span>
          <h1>Turn video into<br /><span class="l2"><span class="mark">action.</span></span></h1>
          <p class="lede">
            Ambient Agents can watch videos, gather evidence over time, answer questions, and invoke tools to take action in
            the real world.
          </p>
          <div class="hero-cta">
            <a class="btn btn-primary" href={`${base}replay/`}>
              <span class="play-dot"><svg viewBox="0 0 12 12"><path d="M2 1l9 5-9 5z"></path></svg></span>
              Watch it work
            </a>
            <a class="btn btn-ghost" href="#quickstart">
              <span class="play-dot"><svg viewBox="0 0 12 12"><path d="M2 1l9 5-9 5z"></path></svg></span>
              Try a video
            </a>
            <button type="button" class="btn btn-ghost" data-agent-setup-open>
              <svg class="gh-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path></svg>
              {AGENT_SETUP_BUTTON}
            </button>
          </div>

          <div class="ask">
            <div class="ask-label">Just ask Ambient:</div>
            <div class="ask-box" aria-live="off">
              <span class="gt">&gt;</span>
              <span><span data-type>score this robot run and explain the failures</span><span class="cursor" aria-hidden="true"></span></span>
            </div>
          </div>
        </div>

        <!-- The Studio, live: a real session running -->
        <div class="hero-demo">
          <div class="sc-browser">
            <div class="sc-bar">
              <span class="sc-dot r"></span><span class="sc-dot y"></span><span class="sc-dot g"></span>
              <span class="sc-url">{heroLabel}</span>
            </div>
            <video src={`${base}assets/video/${heroVideo}`} poster={`${base}assets/video/${heroPoster}`} autoplay muted loop playsinline></video>
          </div>
        </div>
      </div>

      <aside class="award-band reveal" aria-labelledby="eccv-award-title">
        <div class="award-medal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 21h8M12 17v4M7 4h10v4a5 5 0 0 1-10 0V4Z"></path>
            <path d="M7 6H4v1a4 4 0 0 0 4 4M17 6h3v1a4 4 0 0 1-4 4"></path>
          </svg>
        </div>
        <div class="award-copy">
          <span class="eyebrow">Recognized at ECCV 2026</span>
          <h2 id="eccv-award-title">Award-winning video agent</h2>
          <p>
            At the Meta Wearable AI Challenge, Ambient won the <strong>EgoProactive Large Model</strong> and
            <strong>EgoLongQA Small Model</strong> tracks, and placed second in
            <strong>EgoProactive Small Model</strong>.
          </p>
        </div>
        <a class="award-link" href="https://huggingface.co/spaces/facebook/wearable-ai-leaderboard" target="_blank" rel="noopener">
          Official leaderboard <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- ============================ STRUCTURED OUTPUT ============================ -->
  <section class="section-pad hair-top" id="structured">
    <div class="wrap">
      <div class="sc-head">
        <span class="eyebrow mono accent">Any Video , Any outcome</span>
        <h2>Video in, structured data out</h2>
        <p class="lede">
          Hand Ambient Agent a schema and it returns clean, typed JSON — detections, keypoints,
          events, citations — frame-accurate and ready to pipe into your stack.
        </p>
      </div>
      <div class="sc-single">
        <div class="json-frame">
          <video
            src={`${base}assets/video/json-demo.mp4`}
            poster={`${base}assets/video/json-demo.jpg`}
            autoplay
            muted
            loop
            playsinline
          ></video>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ VIDEO → VIDEO ============================ -->
  <section class="section-pad hair-top dotgrid" id="video-video">
    <div class="wrap">
      <div class="sc-head">
        <span class="eyebrow mono accent">Any Video , Any outcome</span>
        <h2>A long video in, a reel out</h2>
        <p class="lede">
          Ambient Agent finds the moments, cuts and reframes to 9:16, and adds captions and a
          music bed — a share-ready social reel from a long video.
        </p>
      </div>
      <div class="io">
        <figure class="io-panel">
          <div class="io-frame vid-src">
            <video src={`${base}assets/video/walkthrough-reel.mp4`} poster={`${base}assets/video/walkthrough-reel.jpg`} autoplay muted loop playsinline></video>
          </div>
          <figcaption class="io-cap">input · 16-min walkthrough</figcaption>
        </figure>
        <div class="io-arrow">→</div>
        <figure class="io-panel">
          <div class="io-frame">
            <video src={`${base}assets/video/reel-out.mp4`} poster={`${base}assets/video/reel-out.jpg`} autoplay muted loop playsinline></video>
          </div>
          <figcaption class="io-cap accent">output · 30-sec social reel</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============================ VIDEO → DOCUMENT ============================ -->
  <section class="section-pad hair-top" id="video-doc">
    <div class="wrap">
      <div class="sc-head">
        <span class="eyebrow mono accent">Any Video , Any outcome</span>
        <h2>Turn a walkthrough into docs</h2>
        <p class="lede">
          Ambient Agent writes polished deliverables from video — product documentation, reports,
          recipes, blog posts — pulling in the right screenshots and citing the source.
        </p>
      </div>
      <div class="io">
        <figure class="io-panel">
          <div class="io-frame vid-src">
            <video src={`${base}assets/video/walkthrough-raw.mp4`} poster={`${base}assets/video/walkthrough-raw.jpg`} autoplay muted loop playsinline></video>
          </div>
          <figcaption class="io-cap">input · product walkthrough</figcaption>
        </figure>
        <div class="io-arrow">→</div>
        <figure class="io-panel">
          <div class="io-frame doc">
            <img src={`${base}assets/img/product-guide.jpg`} alt="Generated product documentation" />
          </div>
          <figcaption class="io-cap accent">output · HTML documentation</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============================ HOW IT WORKS ============================ -->
  <section class="section-pad hair-top" id="how">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">How it works</span>
        <h2>It watches the way we do</h2>
        <p>
          Ambient Agents follow a video through time—pausing, searching, and looking closer when something matters.
        </p>
      </div>

      <div class="pipe reveal">
        <div class="pipe-node">
          <div class="n-label"><span class="mono">Input</span><span class="num">01</span></div>
          <h3>Any video in</h3>
          <ul class="pipe-list">
            <li>File upload</li>
            <li>YouTube URL</li>
            <li>S3 / R2 object</li>
            <li>Any local path</li>
          </ul>
        </div>

        <div class="pipe-conn"><svg viewBox="0 0 60 12"><line class="flow" x1="0" y1="6" x2="52" y2="6" stroke="currentColor" stroke-width="2"></line><path d="M50 2 L58 6 L50 10" fill="none" stroke="currentColor" stroke-width="2"></path></svg></div>

        <div class="pipe-node">
          <div class="n-label"><span class="mono">Agent loop</span><span class="num">02</span></div>
          <h3>Watches with intent</h3>
          <p style="color:var(--text-muted);font-size:0.95rem;margin-top:10px">Moves through time, follows what matters, and looks closer before acting.</p>
          <div class="tool-chips">
            <span class="chip accent dot">Follows the story</span>
            <span class="chip accent dot">Notices what changes</span>
            <span class="chip accent dot">Pauses</span>
            <span class="chip accent dot">Looks closer</span>
            <span class="chip accent dot">Checks the evidence</span>
          </div>
        </div>

        <div class="pipe-conn"><svg viewBox="0 0 60 12"><line class="flow" x1="0" y1="6" x2="52" y2="6" stroke="currentColor" stroke-width="2"></line><path d="M50 2 L58 6 L50 10" fill="none" stroke="currentColor" stroke-width="2"></path></svg></div>

        <div class="pipe-node">
          <div class="n-label"><span class="mono">Output</span><span class="num">03</span></div>
          <h3>Any action out</h3>
          <ul class="pipe-list">
            <li>Processed or annotated video</li>
            <li>Structured outputs</li>
            <li>Documents and artifacts</li>
            <li>Training datasets</li>
            <li>Reward signals</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ USE CASES ============================ -->
  <section class="section-pad hair-top dotgrid" id="use-cases">
    <img class="m m-peek reveal" src={`${base}assets/img/mascot-peeking.webp`} alt="" width="440" height="485" loading="lazy" decoding="async" />
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Use cases</span>
        <h2>One engine, any video, any outcome</h2>
        <p>Point Ambient at the footage you already have and ask for the output you actually need.</p>
      </div>
      <div class="uc-grid">
        <div class="card uc reveal">
          <div class="flowline">site-footage.mp4 <span class="arrow">→</span> <span class="out">inspection-report.json</span></div>
          <h3>Safety and compliance review</h3>
          <p>Find unsafe actions, missing PPE, and procedure violations with timestamped evidence.</p>
        </div>
        <div class="card uc reveal">
          <div class="flowline">dashcam.mp4 <span class="arrow">→</span> <span class="out">incident-report.pdf</span></div>
          <h3>Incident reconstruction</h3>
          <p>Reconstruct what happened, in what order, and where—with cited moments and annotated frames.</p>
        </div>
        <div class="card uc reveal">
          <div class="flowline">screen-recordings/ <span class="arrow">→</span> <span class="out">trajectories.jsonl</span></div>
          <h3>UI agent training data</h3>
          <p>Turn demonstrations into actions, bounding boxes, click-points, and step-by-step trajectories.</p>
        </div>
        <div class="card uc reveal">
          <div class="flowline">robot-runs/ <span class="arrow">→</span> <span class="out">rewards.jsonl</span></div>
          <h3>Robotics evaluation and reward signals</h3>
          <p>Identify successes and failures, score trajectories, and extract the moments that explain each result.</p>
        </div>
        <div class="card uc reveal">
          <div class="flowline">production-runs/ <span class="arrow">→</span> <span class="out">qa-report.csv</span></div>
          <h3>Visual QA and defect detection</h3>
          <p>Review product or process footage against a checklist and surface anomalies with evidence.</p>
        </div>
        <div class="card uc reveal">
          <div class="flowline">raw-video/ <span class="arrow">→</span> <span class="out">annotated-dataset/</span></div>
          <h3>Video dataset curation</h3>
          <p>Search, segment, label, and annotate large video collections for training and evaluation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ ANY VIDEO IN ============================ -->
  <section class="section-pad hair-top" id="in">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Any video in</span>
        <h2>Bring the footage. Ask what matters.</h2>
        <p>
          Whether it’s a ten-second clip or hours of footage, Ambient moves through it selectively—finding and
          examining the moments that matter.
        </p>
      </div>

      <div class="frow reveal">
        <div>
          <span class="kicker">01 · Built for long video</span>
          <h3>It knows when to look closer</h3>
          <p>
            Ambient searches across the full timeline, pauses around relevant moments, and examines them in
            detail—without flattening the video into a transcript.
          </p>
        </div>
        <div class="m-host m-host-watch">
        <img class="m m-watch" src={`${base}assets/img/mascot-watching.webp`} alt="" width="440" height="480" loading="lazy" decoding="async" />
        <div class="visual">
          <div style="width:100%;display:grid;gap:12px">
            <div class="chip accent" style="justify-self:start">source · 00:00 → 42:17</div>
            <div class="tl-track">
              <span style="left:30%;width:14%"></span>
              <span style="left:62%;width:6%;opacity:0.55"></span>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
              <span class="chip">search_clip · 12:00–17:00</span>
              <span class="chip accent">focus_clip · 14:20–14:55</span>
            </div>
          </div>
        </div>
        </div>
      </div>

      <div class="frow rev reveal">
        <div class="visual">
          <div class="iso">
            <div class="layer"><span>UPLOAD</span></div>
            <div class="layer"><span>YOUTUBE</span></div>
            <div class="layer"><span>S3 / R2 RANGE-READ</span></div>
            <div class="layer"><span>LOCAL PATH</span></div>
          </div>
        </div>
        <div>
          <span class="kicker">02 · Efficient by design</span>
          <h3>Reads only what it needs</h3>
          <p>
            Ambient doesn’t pull in hours of footage to examine a few seconds. It fetches only the moments it
            needs—often just <strong class="accent">1–2% of the source</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ ANY ACTION OUT ============================ -->
  <section class="section-pad hair-top dotgrid" id="out">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Any action out</span>
        <h2>Answers you can build on</h2>
        <p>Not a paragraph you have to re-parse — a structured, verifiable output your code can consume directly.</p>
      </div>

      <div class="grid-3">
        <div class="card reveal">
          <div class="ic-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"></path></svg></div>
          <h3>Citation-backed answers</h3>
          <p>Every claim links to a timestamp or range in the source. Clip-local times are rewritten to the global timeline, so citations land on the right moment.</p>
        </div>
        <div class="card reveal">
          <div class="ic-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"></path></svg></div>
          <h3>JSON-Schema output</h3>
          <p>Pass a schema; get typed data back. The final answer is steered to your shape, with validation and retry when it must be exact.</p>
        </div>
        <div class="card reveal">
          <div class="ic-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 9h6v6H9z"></path></svg></div>
          <h3>Boxes &amp; click-points</h3>
          <p>Bounding boxes and click coordinates on a normalized 0–1000 grid — drawn and visually verified before they reach your answer.</p>
        </div>
        <div class="card reveal">
          <div class="ic-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path></svg></div>
          <h3>Downloadable artifacts</h3>
          <p>The agent can run <span class="inline-code">bash</span> + ffmpeg to render clips, extract data, or build a report — then hand back a download link.</p>
        </div>
        <div class="card reveal">
          <div class="ic-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg></div>
          <h3>Streaming events</h3>
          <p>Reasoning, tool calls and results, per-request tokens and cost — streamed live over SSE. Full observability, not a black box.</p>
        </div>
        <div class="card reveal">
          <div class="ic-tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"></path></svg></div>
          <h3>An MCP tool</h3>
          <p><span class="inline-code">analyze_video</span> plugs into Claude Code or any MCP client — streaming progress, a final answer, and a session id for follow-ups.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ BUILT TO SCALE ============================ -->
  <section class="section-pad hair-top" id="scale">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Built to scale</span>
        <h2>One engine, however you run it</h2>
        <p>
          Run Ambient locally or distribute it across a cluster. Use Studio interactively, run headless batch
          workloads, or integrate through the SDK and API. Isolate media execution in per-session sandboxes for safer,
          independently scalable workloads.
        </p>
      </div>
      <div class="m-host m-host-fast">
      <img class="m m-fast" src={`${base}assets/img/mascot-fast.webp`} alt="" width="440" height="481" loading="lazy" decoding="async" />
      <div class="nums reveal">
        <div class="num-cell">
          <div class="big"><span class="accent">Laptop</span></div>
          <div class="lbl">Run locally</div>
          <div class="sub">engine + Studio</div>
        </div>
        <div class="num-cell">
          <div class="big">Cluster</div>
          <div class="lbl">Distribute workers</div>
          <div class="sub">shared durable state</div>
        </div>
        <div class="num-cell">
          <div class="big">Studio</div>
          <div class="lbl">Work interactively</div>
          <div class="sub">explore, ask, inspect</div>
        </div>
        <div class="num-cell">
          <div class="big">Headless</div>
          <div class="lbl">SDK + API</div>
          <div class="sub">batch or embed</div>
        </div>
      </div>
      </div>

      <div class="grid-3" style="margin-top:28px">
        <div class="card reveal">
          <h3>Scale without session pinning</h3>
          <p>Postgres and Redis keep state outside the process, so any worker can continue any session.</p>
        </div>
        <div class="card reveal">
          <h3>Sandboxed media execution</h3>
          <p>Isolate each session’s media workload in its own sandbox while orchestration and model calls remain under your control.</p>
        </div>
        <div class="card reveal">
          <h3>Integrate it anywhere</h3>
          <p>Use Studio, run batch jobs through the SDK, or embed the API directly into your application.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================ QUICKSTART ============================ -->
  <section class="section-pad hair-top dotgrid" id="quickstart">
    <div class="wrap">
      <div class="sec-head reveal">
        <span class="eyebrow">Try it</span>
        <h2>From one command to your first answer</h2>
        <p>
          The installer starts Ambient, Studio, Postgres, and Redis in Docker. You’ll need Docker Compose and an API
          key for an OpenAI-compatible model.
        </p>
      </div>
      <div class="quickstart-single reveal m-row-sit">
        <div class="m-host">
        <img class="m m-sit" src={`${base}assets/img/mascot-sitting.webp`} alt="" width="440" height="552" loading="lazy" decoding="async" />
        <div class="code">
          <div class="code-head"><span class="dots"><i></i><i></i><i></i></span><span class="file">install</span></div>
          <pre><span class="cc"># install Ambient + Studio — safe to re-run</span>
curl -fsSL {installUrl} | bash

<span class="cc"># when ready, the installer prints and opens Studio</span>
<span class="cc"># add a video or paste a YouTube link, then ask:</span>
<span class="cp">&gt;</span> Investigate the incident and share a report with evidence ?</pre>
        </div>
        <p class="quickstart-alt">Or let your coding agent set it up. Paste this into Claude Code, Codex, or Cursor:</p>
        <div class="code">
          <div class="code-head"><span class="dots"><i></i><i></i><i></i></span><span class="file">paste into your coding agent</span></div>
          <pre>{AGENT_SETUP_PROMPT}</pre>
        </div>
        <p class="quickstart-note">Deploying for a team or cluster? Detailed self-hosting guidance is coming soon.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ FINAL CTA ============================ -->
  <section class="section-pad">
    <div class="wrap">
      <div class="cta-band reveal">
        <span class="eyebrow">Video to action</span>
        <h2>Turn any video into<br /><em>something you can act on.</em></h2>
        <div class="row">
          <a class="btn btn-accent" href="#quickstart">Try a video <span class="chev">›</span></a>
          <a class="btn btn-ghost" href={`${base}docs/`}>Read the docs <span class="chev">›</span></a>
          <a class="btn btn-ghost" href={github} target="_blank" rel="noopener">Star on GitHub <span class="chev">›</span></a>
        </div>
      </div>
    </div>
  </section>

  <AgentSetupModal />

  <script slot="scripts" is:inline src={`${base}assets/js/hero.js`}></script>
</Base>
